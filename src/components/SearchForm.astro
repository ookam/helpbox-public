---
interface Props {
  audienceId: string;
  value?: string;
  compact?: boolean;
}

const { audienceId, value = '', compact = false } = Astro.props;
---

<form class="search-form" action={`/${audienceId}/search/`} method="get" role="search" data-compact={compact || undefined}>
  <label for={`help-search-${audienceId}`}>記事を検索</label>
  <input
    id={`help-search-${audienceId}`}
    name="q"
    type="search"
    value={value}
    placeholder="キーワードを入力してください"
    autocomplete="off"
  />
  <button type="submit">検索</button>
</form>
